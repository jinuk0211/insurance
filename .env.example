# CODEF insurance lookup (sandbox | demo | production)
CODEF_ENV=sandbox
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=

# PostgreSQL (Railway, Neon, or another standard PostgreSQL provider)
DATABASE_URL=
DATABASE_POOL_MAX=3
# Railway public TCP may require false for its self-signed certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=

# 0 or unset: reuse the latest successful DB result indefinitely. Positive hours opt into expiry.
INSURANCE_CACHE_TTL_HOURS=0

# Generate independent 32-byte base64 secrets for encrypted payloads and HMAC keys.
HISTORY_ENC_KEY=
USER_KEY_SECRET=

# Deployed live-data APIs remain closed until GA advisor auth and customer access checks exist.
INSURANCE_DEMO_ONLY=true
# Only for explicit local development testing; never set on a deployment.
INSURANCE_LOCAL_LIVE_TEST=false

# Legacy preview credentials do not authorize live-data APIs.
INSURANCE_PREVIEW_USER=
INSURANCE_PREVIEW_PASSWORD=

# Required for the daily disclosure collector; without it the endpoint returns 401. Vercel Cron sends it as a bearer token.
CRON_SECRET=
CATALOG_CRAWLER_USER_AGENT=KFinLegalCatalogBot/1.0 (+https://your-domain.example)
CATALOG_MAX_PRODUCTS_PER_RUN=3
CATALOG_SNAPSHOT_LIMIT=1

# Server-only terms Q&A. Configure as sensitive in Vercel Production and Preview.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
