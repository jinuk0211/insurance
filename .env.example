# CODEF insurance lookup (sandbox | demo | production)
CODEF_ENV=sandbox
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=

# PostgreSQL (Railway, Neon, or another standard PostgreSQL provider)
DATABASE_URL=
DATABASE_POOL_MAX=3
# Railway public TCP may require false for its self-signed certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=

# 0 or unset: reuse the latest successful DB result indefinitely. Positive hours opt into expiry.
INSURANCE_CACHE_TTL_HOURS=0

# Generate independent 32-byte base64 secrets for encrypted payloads and HMAC keys.
HISTORY_ENC_KEY=
USER_KEY_SECRET=

# Keep the public submission in synthetic-data-only mode.
INSURANCE_DEMO_ONLY=true

# Optional server-to-server protection for a separately enabled live API.
INSURANCE_PREVIEW_USER=
INSURANCE_PREVIEW_PASSWORD=

# Daily public insurance-disclosure collector. Vercel Cron sends this as a bearer token.
CRON_SECRET=
CATALOG_CRAWLER_USER_AGENT=KFinLegalCatalogBot/1.0 (+https://your-domain.example)
CATALOG_MAX_PRODUCTS_PER_RUN=3
CATALOG_SNAPSHOT_LIMIT=1
